# Application
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Authentication (generate a unique value with: openssl rand -base64 48)
JWT_SECRET=replace-with-a-unique-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

# PostgreSQL (Docker Compose uses these variables)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=spendwise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# NestJS / TypeORM (use this or individual POSTGRES_* values)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spendwise

# Run pending migrations automatically on app startup (optional)
DATABASE_MIGRATIONS_RUN=false
